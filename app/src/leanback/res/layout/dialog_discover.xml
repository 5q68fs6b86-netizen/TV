<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDialogRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <ImageView
        android:id="@+id/poster"
        android:layout_width="140dp"
        android:layout_height="200dp"
        android:contentDescription="@string/home_discover"
        android:scaleType="centerCrop" />

    <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
        android:id="@+id/name"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_toEndOf="@+id/poster"
        android:ellipsize="end"
        android:maxLines="2"
        android:textSize="20sp"
        tools:text="Name" />

    <com.fongmi.android.tv.ui.custom.JetStreamBodyTextView
        android:id="@+id/meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/name"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="6dp"
        android:singleLine="true"
        tools:text="2024 · 8.2" />

    <com.fongmi.android.tv.ui.custom.JetStreamBodyTextView
        android:id="@+id/content"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_below="@+id/meta"
        android:layout_above="@+id/bottom"
        android:layout_alignStart="@+id/name"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:maxLines="6"
        tools:text="Overview" />

    <com.fongmi.android.tv.ui.custom.JetStreamDialogButtonRowLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/name"
        android:layout_alignBottom="@+id/poster"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/discover_search_play" />

        <com.fongmi.android.tv.ui.custom.JetStreamButtonTextView
            android:id="@+id/cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="@string/dialog_negative" />

    </com.fongmi.android.tv.ui.custom.JetStreamDialogButtonRowLayout>
</com.fongmi.android.tv.ui.custom.JetStreamDialogRelativeLayout>
