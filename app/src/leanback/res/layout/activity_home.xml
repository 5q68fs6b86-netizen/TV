<?xml version="1.0" encoding="utf-8"?>
<!--
    主页 Activity 布局
    使用 TV 设计系统 Token
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_background_primary"
    android:keepScreenOn="true"
    android:orientation="vertical">

    <!-- 顶部工具栏 -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_topbar_height"
        android:paddingStart="@dimen/tv_safe_margin_horizontal"
        android:paddingEnd="@dimen/tv_safe_margin_horizontal"
        android:paddingTop="@dimen/tv_safe_margin_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 左侧标题区域 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Logo 和标题 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:gravity="center_vertical"
                android:layout_marginEnd="@dimen/tv_spacing_sm"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/logo"
                    android:layout_width="@dimen/tv_topbar_logo_height"
                    android:layout_height="@dimen/tv_topbar_logo_height"
                    android:layout_marginEnd="@dimen/tv_spacing_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    tools:src="@drawable/ic_logo"
                    tools:visibility="visible" />

                <com.fongmi.android.tv.ui.custom.CustomTitleView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center|start"
                    android:focusable="false"
                    android:text="@string/app_name"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="@dimen/tv_topbar_title_size" />

            </LinearLayout>

            <!-- 锁定图标 -->
            <ImageView
                android:id="@+id/homeSiteLock"
                android:layout_width="@dimen/tv_icon_md"
                android:layout_height="@dimen/tv_icon_md"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/tv_spacing_xs"
                android:src="@drawable/ic_home_lock"
                app:tint="@color/tv_icon_secondary"
                android:focusable="false"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- 右侧时钟区域 -->
        <TextView
            android:id="@+id/clock"
            style="@style/TV.Text.Title.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tv_text_secondary"
            tools:text="07/25 09:20:00" />

    </LinearLayout>

    <!-- 主内容区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/tv_spacing_sm"
        android:orientation="vertical">

        <!-- 占位空白 -->
        <View
            android:id="@+id/blank"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_spacing_sm"
            android:visibility="gone" />

        <!-- 顶部分类/类型选择器 -->
        <com.fongmi.android.tv.ui.custom.CustomHorizontalGridView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/tv_spacing_sm"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="@dimen/tv_safe_margin_horizontal"
            android:paddingEnd="@dimen/tv_spacing_sm"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

        <!-- 主内容 ViewPager -->
        <com.fongmi.android.tv.ui.custom.CustomViewPager
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>

</LinearLayout>