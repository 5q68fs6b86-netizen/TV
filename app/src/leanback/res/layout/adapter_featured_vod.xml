<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="324dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:foreground="@drawable/selector_featured_vod">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/jetstream_surface_container_high"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/JetStream.Hero"
        tools:src="@drawable/wallpaper_1" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imageB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/jetstream_surface_container_high"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:shapeAppearanceOverlay="@style/JetStream.Hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_featured_left_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_featured_bottom_scrim" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/name"
            style="@style/Shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="36sp"
            tools:text="蜘蛛人" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/meta"
            style="@style/Shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="16sp"
            tools:text="2024  |  泥巴  |  1080p" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_featured_button"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_featured_play" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/play"
                android:textColor="@color/jetstream_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/shape_featured_indicator"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        tools:visibility="visible" />

</FrameLayout>
