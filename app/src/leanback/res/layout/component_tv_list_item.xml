<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 列表项组件布局
    用于 TVListItemView 组件
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tv_list_item_height_md"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/tv_list_item_padding_horizontal">

    <!-- 图标 -->
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/tv_list_item_icon_size"
        android:layout_height="@dimen/tv_list_item_icon_size"
        android:layout_marginEnd="@dimen/tv_spacing_md"
        android:scaleType="centerInside"
        app:tint="@color/tv_icon_primary"
        tools:src="@drawable/ic_setting_delete"
        tools:visibility="visible" />

    <!-- 文字区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:id="@+id/title"
            style="@style/TV.Text.Body.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tv_text_primary"
            tools:text="设置项标题" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/subtitle"
            style="@style/TV.Text.Body.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_spacing_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/tv_text_secondary"
            android:visibility="gone"
            tools:text="设置项描述"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- 右侧值文本 -->
    <TextView
        android:id="@+id/value"
        style="@style/TV.Text.Body.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_spacing_md"
        android:textColor="@color/tv_text_secondary"
        android:visibility="gone"
        tools:text="当前值"
        tools:visibility="visible" />

    <!-- 右侧箭头 -->
    <ImageView
        android:id="@+id/arrow"
        android:layout_width="@dimen/tv_icon_sm"
        android:layout_height="@dimen/tv_icon_sm"
        android:layout_marginStart="@dimen/tv_spacing_sm"
        android:src="@drawable/ic_action_arrow"
        app:tint="@color/tv_icon_secondary"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- 右侧开关 -->
    <Switch
        android:id="@+id/switch_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tv_spacing_sm"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>