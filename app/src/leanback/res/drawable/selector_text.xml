<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
          android:enterFadeDuration="@android:integer/config_shortAnimTime"
          android:exitFadeDuration="@android:integer/config_shortAnimTime"> <!-- 添加淡入淡出动画 -->

    <!-- 聚焦状态 (Focused) -->
    <!-- M3 通常使用状态层或轮廓。这里用一个略微抬高的表面色 + 主色轮廓来模拟 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- 背景：使用比普通稍高的表面容器色 -->
            <solid android:color="?attr/colorSurfaceContainerHigh" />
            <!-- 形状：使用 M3 中等圆角定义 (如果主题中定义了的话) -->
            <corners android:radius="?attr/shapeCornerMedium" />
            <!-- 轮廓：使用主色作为聚焦轮廓 -->
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>

    <!-- 激活/选中状态 (Activated) -->
    <!-- M3 通常使用 Primary Container 颜色 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorPrimaryContainer" />
            <corners android:radius="?attr/shapeCornerMedium" />
            <!-- 激活状态通常不需要额外轮廓 -->
        </shape>
    </item>

    <!-- 按下状态 (Pressed) - 添加这个以改善交互反馈 -->
    <!-- 使用 M3 的 controlHighlight (通常用于 Ripple) 作为背景色 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorControlHighlight" />
            <corners android:radius="?attr/shapeCornerMedium" />
        </shape>
    </item>

    <!-- 默认/普通状态 (Normal) -->
    <item>
        <shape android:shape="rectangle">
            <!-- 背景：使用标准的表面容器色 -->
            <solid android:color="?attr/colorSurfaceContainer" />
            <!-- 形状：与聚焦/激活状态保持一致 -->
            <corners android:radius="?attr/shapeCornerMedium" />
        </shape>
    </item>

</selector>