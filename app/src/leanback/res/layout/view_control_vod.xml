<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/video_control_modern_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <!-- 解析源选择器 -->
    <com.fongmi.android.tv.ui.custom.CustomHorizontalGridView
        android:id="@+id/parse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        tools:layout_height="40dp" />

    <!-- 主要控制按钮区域 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/actionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <!-- 播放控制组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/prev"
                    style="@style/VideoControlButton.Primary"
                    android:text="@string/play_prev"
                    android:drawableTop="@drawable/ic_skip_previous"
                    android:drawablePadding="4dp" />

                <TextView
                    android:id="@+id/next"
                    style="@style/VideoControlButton.Primary"
                    android:text="@string/play_next"
                    android:drawableTop="@drawable/ic_skip_next"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/episodes"
                    style="@style/VideoControlButton.Primary"
                    android:text="@string/play_episodes"
                    android:drawableTop="@drawable/ic_playlist"
                    android:drawablePadding="4dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 播放器设置组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/player"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="EXO" />

                <TextView
                    android:id="@+id/decode"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="硬解"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/reset"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="刷新"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 播放设置组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginEnd="16dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/speed"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="1.00" />

                <TextView
                    android:id="@+id/scale"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="預設"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/loop"
                    style="@style/VideoControlButton.Secondary"
                    android:text="@string/play_loop"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 轨道设置组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginEnd="16dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/text"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="3"
                    android:text="@string/play_track_text"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/audio"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="1"
                    android:text="@string/play_track_audio"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginStart="4dp" />

                <TextView
                    android:id="@+id/video"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="2"
                    android:text="@string/play_track_video"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 时间设置组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginEnd="16dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/opening"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="片头" />

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/ending"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="片尾"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- 弹幕设置 -->
            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/danmu"
                style="@style/VideoControlButton.Accent"
                android:text="@string/play_danmu" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 进度条区域 -->
    <com.fongmi.android.tv.ui.custom.CustomSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

</LinearLayout>