<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive / SplashScreen icon layer.
     Viewport 108dp-equivalent (160 units). Mark scaled about center so a clear ring
     remains between the brand and the circular icon mask (safe zone + breathing room).
     scale s about 80: translate = 80*(1-s). -->
