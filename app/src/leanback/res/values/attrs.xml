<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 用于在“主色反色”背景上显示的文本/图标颜色 -->
    <!-- 例如，如果你的主色是浅色，这个颜色可能是深色；如果主色是深色，这个颜色可能是浅色 -->
    <!-- format="color|reference" 表示其值可以是 #RRGGBB 格式，也可以是 @color/some_color 的引用 -->
    <attr name="colorOnPrimaryInverse" format="#99ffffff" />

    <!-- 用于覆盖层（如删除提示）的背景颜色或 Drawable -->
    <!-- format="color|reference" 同样表示可以是颜色值或资源引用 -->
    <attr name="scrimBackground" format="#99000000" />

    <!-- 如果你确定其他 ?attr/ 引用也是自定义的，也需要在这里声明 -->
    <!-- 例如，如果 Vod.Grid 样式里引用了自定义属性，也要加进来 -->

</resources>