<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamSettingControlRowLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.fongmi.android.tv.ui.custom.JetStreamLargeChipRoundTextView
        android:id="@+id/text"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:singleLine="true"
        tools:text="https://fongmi.github.io/live.json" />

    <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
        android:id="@+id/pass"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_live_pass" />

    <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
        android:id="@+id/boot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_live_boot" />

</com.fongmi.android.tv.ui.custom.JetStreamSettingControlRowLayout>
