<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器小部件布局
    包含信息显示、加载、错误等状态
    遵循 Google TV 设计规范
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ════════════════════════════════════════════════════════════════════════════
         视频信息区域 (标题和分辨率)
         ════════════════════════════════════════════════════════════════════════════ -->
    <RelativeLayout
        android:id="@+id/info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/title"
            style="@style/VideoTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tv_spacing_md"
            android:layout_marginTop="@dimen/tv_spacing_md"
            android:layout_marginEnd="100dp"
            android:letterSpacing="0.02"
            android:singleLine="true"
            tools:text="慶餘年第一季：第一集" />

        <TextView
            android:id="@+id/size"
            style="@style/VideoInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"
            android:layout_alignStart="@+id/title"
            android:layout_marginBottom="@dimen/tv_spacing_md"
            tools:text="1920 x 1080" />
    </RelativeLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         加载进度区域
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <include layout="@layout/view_progress" />

        <TextView
            android:id="@+id/traffic"
            style="@style/VideoInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_spacing_xs"
            android:visibility="gone"
            tools:text="120KB/s" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         错误提示区域
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_widget_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/tv_spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/tv_icon_xxl"
            android:layout_height="@dimen/tv_icon_xxl"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_error"
            android:tint="@color/tv_status_error" />

        <TextView
            android:id="@+id/text"
            style="@style/VideoInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_spacing_md"
            android:gravity="center"
            tools:text="@string/error_play_url" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         中央控制区域 (播放/暂停状态)
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_widget_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/tv_spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/action"
            android:layout_width="@dimen/tv_icon_xxl"
            android:layout_height="@dimen/tv_icon_xxl"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/tv_icon_primary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_position"
                style="@style/VideoTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="00:00:00" />

            <TextView
                style="@style/VideoTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/tv_spacing_xxs"
                android:layout_marginEnd="@dimen/tv_spacing_xxs"
                android:text="/" />

            <TextView
                android:id="@+id/exo_duration"
                style="@style/VideoTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="00:00:00" />
        </LinearLayout>
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         快进/快退指示器
         ════════════════════════════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/speed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center"
        android:layout_marginTop="@dimen/tv_spacing_lg"
        android:src="@drawable/ic_widget_forward"
        android:tint="@color/tv_icon_primary"
        android:visibility="gone" />

    <!-- ════════════════════════════════════════════════════════════════════════════
         亮度调节提示
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bright"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_widget_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/tv_spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/brightIcon"
            android:layout_width="@dimen/tv_icon_lg"
            android:layout_height="@dimen/tv_icon_lg"
            android:layout_marginEnd="@dimen/tv_spacing_md"
            android:tint="@color/tv_icon_primary"
            tools:src="@drawable/ic_widget_bright_high" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/brightProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/tv_focus_primary"
            app:trackColor="@color/tv_surface_overlay" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         音量调节提示
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/volume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/tv_widget_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/tv_spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/volumeIcon"
            android:layout_width="@dimen/tv_icon_lg"
            android:layout_height="@dimen/tv_icon_lg"
            android:layout_marginEnd="@dimen/tv_spacing_md"
            android:tint="@color/tv_icon_primary"
            tools:src="@drawable/ic_widget_volume_high" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/volumeProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            app:indicatorColor="@color/tv_focus_primary"
            app:trackColor="@color/tv_surface_overlay" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         预览图片
         ════════════════════════════════════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="invisible" />

</FrameLayout>
