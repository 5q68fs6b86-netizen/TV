<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 卡片背景
    支持默认、焦点、按下状态
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_surface_pressed"/>
            <corners android:radius="@dimen/tv_card_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_primary"/>
        </shape>
    </item>
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_surface_focused"/>
            <corners android:radius="@dimen/tv_card_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_ring"/>
        </shape>
    </item>
    
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_surface_hover"/>
            <corners android:radius="@dimen/tv_card_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_default"
                android:color="@color/tv_border_default"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_card_surface"/>
            <corners android:radius="@dimen/tv_card_corner_radius"/>
        </shape>
    </item>
    
</selector>