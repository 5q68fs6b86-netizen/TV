<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:keepScreenOn="true"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xlarge">

        <!-- VOD 配置行 -->
        <LinearLayout
            style="@style/TVSettingRow"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:id="@+id/vod"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="0.3"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_vod" />

                <TextView
                    android:id="@+id/vodUrl"
                    style="@style/TVSettingValue"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    tools:ignore="NestedWeights"
                    tools:text="https://" />

            </LinearLayout>

            <ImageView
                android:id="@+id/vodHome"
                style="@style/TVIconButton"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:src="@drawable/ic_setting_home" />

            <ImageView
                android:id="@+id/vodHistory"
                style="@style/TVIconButton"
                android:src="@drawable/ic_setting_history" />

        </LinearLayout>

        <!-- Live 配置行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/live"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="0.3"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_live" />

                <TextView
                    android:id="@+id/liveUrl"
                    style="@style/TVSettingValue"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    tools:ignore="NestedWeights"
                    tools:text="https://" />

            </LinearLayout>

            <ImageView
                android:id="@+id/liveHome"
                style="@style/TVIconButton"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:src="@drawable/ic_setting_home" />

            <ImageView
                android:id="@+id/liveHistory"
                style="@style/TVIconButton"
                android:src="@drawable/ic_setting_history" />

        </LinearLayout>

        <!-- Wall 配置行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/wall"
                style="@style/TVSettingItem"
                android:nextFocusDown="@id/player">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_width="0dp"
                    android:layout_weight="0.3"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_wall" />

                <TextView
                    android:id="@+id/wallUrl"
                    style="@style/TVSettingValue"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    tools:ignore="NestedWeights"
                    tools:text="https://" />

            </LinearLayout>

            <ImageView
                android:id="@+id/wallDefault"
                style="@style/TVIconButton"
                android:layout_marginEnd="@dimen/spacing_normal"
                android:nextFocusDown="@id/player"
                android:src="@drawable/ic_setting_home" />

            <ImageView
                android:id="@+id/wallRefresh"
                style="@style/TVIconButton"
                android:nextFocusDown="@id/player"
                android:src="@drawable/ic_setting_refresh" />

        </LinearLayout>

        <!-- Player / Danmu 行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/player"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:text="@string/setting_player" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/danmu"
                style="@style/TVSettingItem.Last">

                <TextView
                    style="@style/TVSettingLabel"
                    android:text="@string/setting_danmu" />

            </LinearLayout>

        </LinearLayout>

        <!-- Custom / Proxy 行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/custom"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:text="@string/setting_custom" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/proxy"
                style="@style/TVSettingItem.Last">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_proxy" />

                <TextView
                    android:id="@+id/proxyText"
                    style="@style/TVSettingValue"
                    tools:text="http" />

            </LinearLayout>

        </LinearLayout>

        <!-- Backup / Restore 行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/backup"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_backup" />

                <TextView
                    android:id="@+id/backupText"
                    style="@style/TVSettingValue"
                    tools:text="Auto" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/restore"
                style="@style/TVSettingItem.Last">

                <TextView
                    style="@style/TVSettingLabel"
                    android:text="@string/setting_restore" />

            </LinearLayout>

        </LinearLayout>

        <!-- Cache / DoH 行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/cache"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_cache" />

                <TextView
                    android:id="@+id/cacheText"
                    style="@style/TVSettingValue"
                    tools:text="1.0 MB" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/doh"
                style="@style/TVSettingItem.Last">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_doh" />

                <TextView
                    android:id="@+id/dohText"
                    style="@style/TVSettingValue"
                    tools:text="Google" />

            </LinearLayout>

        </LinearLayout>

        <!-- Version / About 行 -->
        <LinearLayout style="@style/TVSettingRow">

            <LinearLayout
                android:id="@+id/version"
                style="@style/TVSettingItem">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_version" />

                <TextView
                    android:id="@+id/versionText"
                    style="@style/TVSettingValue"
                    tools:text="1.2.1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/about"
                style="@style/TVSettingItem.Last">

                <TextView
                    style="@style/TVSettingLabel"
                    android:layout_marginEnd="@dimen/spacing_normal"
                    android:text="@string/setting_about" />

                <TextView
                    android:id="@+id/aboutText"
                    style="@style/TVSettingValue"
                    tools:text="about" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
