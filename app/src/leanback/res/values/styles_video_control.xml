<resources>
    <!-- 控制栏背景 -->
    <style name="VideoControlBackground">
        <item name="android:background">@drawable/video_control_gradient_bg</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- 控制按钮基础样式 -->
    <style name="VideoControlButton">
        <item name="android:background">@drawable/video_control_button_selector</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
    </style>

    <!-- 播放按钮样式 -->
    <style name="VideoPlayButton">
        <item name="android:background">@drawable/video_play_button_bg</item>
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- 进度条样式 -->
    <style name="VideoSeekBar">
        <item name="android:progressDrawable">@drawable/video_seekbar_progress</item>
        <item name="android:thumb">@drawable/video_seekbar_thumb</item>
        <item name="android:thumbOffset">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
    </style>
</resources>