<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDialogSurfaceLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamSheetHeaderView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="14dp"
        app:jetStreamTitle="@string/setting_site" />

    <com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <com.fongmi.android.tv.ui.custom.JetStreamDialogListRecyclerView
            android:id="@+id/recycler"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="12dp"
            app:maxHeight="264dp"
            tools:itemCount="5"
            tools:listitem="@layout/adapter_site" />

        <com.fongmi.android.tv.ui.custom.JetStreamDialogActionRailLayout
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
                android:id="@+id/search"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/search"
                android:nextFocusDown="@id/change"
                android:padding="8dp"
                android:src="@drawable/ic_site_search"
                app:tint="@color/jetstream_control_text" />

            <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
                android:id="@+id/change"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/search"
                android:nextFocusDown="@id/select"
                android:padding="8dp"
                android:src="@drawable/ic_site_change"
                app:tint="@color/jetstream_control_text" />

            <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
                android:id="@+id/select"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/change"
                android:nextFocusDown="@id/cancel"
                android:padding="8dp"
                android:src="@drawable/ic_site_select"
                app:tint="@color/jetstream_control_text" />

            <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
                android:id="@+id/cancel"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/select"
                android:nextFocusDown="@id/mode"
                android:padding="8dp"
                android:src="@drawable/ic_site_cancel"
                app:tint="@color/jetstream_control_text" />

            <com.fongmi.android.tv.ui.custom.JetStreamChipRoundIconView
                android:id="@+id/mode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/cancel"
                android:nextFocusDown="@id/mode"
                android:padding="8dp"
                app:tint="@color/jetstream_control_text"
                tools:src="@drawable/ic_site_list" />

        </com.fongmi.android.tv.ui.custom.JetStreamDialogActionRailLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout>
</com.fongmi.android.tv.ui.custom.JetStreamDialogSurfaceLayout>
