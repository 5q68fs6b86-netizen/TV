<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDanmakuSectionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_scroll"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showScrollSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tabDisplay" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_top"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showTopSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_bottom"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showBottomSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_reverse"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showReverseSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_positioned"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showPositionedSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_subtitle"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showSubtitleSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:addStatesFromChildren="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="4dp">

        <com.fongmi.android.tv.ui.custom.JetStreamLabelTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:text="@string/danmaku_show_special"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.fongmi.android.tv.ui.custom.JetStreamSwitch
            style="@style/JetStream.Switch"
            android:id="@+id/showSpecialSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>
</com.fongmi.android.tv.ui.custom.JetStreamDanmakuSectionLayout>
