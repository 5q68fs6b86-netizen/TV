<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamSheetSurfaceLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="20dp">

    <com.fongmi.android.tv.ui.custom.JetStreamSubtitleIconView
        android:id="@+id/large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_subtitle_large"
        app:tint="@color/jetstream_control_text" />

    <com.fongmi.android.tv.ui.custom.JetStreamSubtitleIconView
        android:id="@+id/small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_subtitle_small"
        app:tint="@color/jetstream_control_text" />

    <com.fongmi.android.tv.ui.custom.JetStreamSubtitleIconView
        android:id="@+id/up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_subtitle_up"
        app:tint="@color/jetstream_control_text" />

    <com.fongmi.android.tv.ui.custom.JetStreamSubtitleIconView
        android:id="@+id/down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_subtitle_down"
        app:tint="@color/jetstream_control_text" />

    <com.fongmi.android.tv.ui.custom.JetStreamSubtitleIconView
        android:id="@+id/reset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:padding="8dp"
        android:src="@drawable/ic_subtitle_reset"
        app:tint="@color/jetstream_control_text" />

</com.fongmi.android.tv.ui.custom.JetStreamSheetSurfaceLayout>
