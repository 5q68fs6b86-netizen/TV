<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础控制按钮样式 -->
    <style name="VideoControlButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>
    </style>

    <!-- 主要按钮样式 -->
    <style name="VideoControlButton.Primary">
        <item name="android:background">@drawable/video_button_primary_selector</item>
        <item name="android:textColor">@color/video_button_primary_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 次要按钮样式 -->
    <style name="VideoControlButton.Secondary">
        <item name="android:background">@drawable/video_button_secondary_selector</item>
        <item name="android:textColor">@color/video_button_secondary_text</item>
    </style>

    <!-- 强调按钮样式 -->
    <style name="VideoControlButton.Accent">
        <item name="android:background">@drawable/video_button_accent_selector</item>
        <item name="android:textColor">@color/video_button_accent_text</item>
    </style>
    <!-- ... 保留你已有的其他样式 ... -->

    <style name="VideoControlButton.IconOnly">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/video_button_primary_selector</item>
        <!-- 关键：使用颜色选择器来为图标着色 -->
        <item name="android:drawableTint">@color/icon_tint_selector</item>
        <item name="android:drawableTintMode">src_in</item>
        <item name="android:padding">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:stateListAnimator">@animator/button_elevation</item>    </style>
</resources>