<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDiscoverHeroLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="24dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamSupportingLabelTextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="TMDB · 今日趋势" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroTitleTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="电影杂志封面标题" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroMetaTextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="2026  |  8.7分  |  剧情" />

        <com.fongmi.android.tv.ui.custom.JetStreamBodyTextView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="5"
            tools:text="影片简介在海报获得焦点后随之更新。" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/posters"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

</com.fongmi.android.tv.ui.custom.JetStreamDiscoverHeroLayout>
