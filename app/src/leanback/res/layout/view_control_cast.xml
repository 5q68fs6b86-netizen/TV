<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPlaybackControlBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="28dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackBodyTextView
        android:id="@+id/seek_preview"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:gravity="center"
        android:visibility="gone"
        tools:text="00:30 / 01:30"
        tools:visibility="visible" />

    <androidx.media3.ui.PlayerSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />

    <include
        android:id="@+id/action"
        layout="@layout/view_control_cast_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</com.fongmi.android.tv.ui.custom.JetStreamPlaybackControlBarLayout>
