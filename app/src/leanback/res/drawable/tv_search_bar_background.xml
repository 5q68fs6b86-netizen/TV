<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 搜索栏背景
    圆角搜索框，支持焦点状态
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_search_bar_focused"/>
            <corners android:radius="@dimen/tv_search_bar_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_ring"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_search_bar_bg"/>
            <corners android:radius="@dimen/tv_search_bar_corner_radius"/>
        </shape>
    </item>
    
</selector>