<?xml version="1.0" encoding="utf-8"?>
<!--
    视频详情页操作按钮背景
    用于详情/收藏/换源等按钮
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_primary" />
            <corners android:radius="@dimen/tv_radius_md" />
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_primary_bg_pressed" />
            <corners android:radius="@dimen/tv_radius_md" />
        </shape>
    </item>
    
    <!-- 激活/选中状态 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_selected" />
            <corners android:radius="@dimen/tv_radius_md" />
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_variant" />
            <corners android:radius="@dimen/tv_radius_md" />
        </shape>
    </item>
</selector>