<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器图标按钮背景
    圆形按钮，用于播放控制
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_focus_primary" />
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_button_primary_bg_pressed" />
        </shape>
    </item>
    
    <!-- 激活/选中状态 -->
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/tv_focus_primary_variant" />
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/tv_player_button_bg" />
        </shape>
    </item>
</selector>