<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器控制栏布局
    遵循 Google TV 设计规范
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/tv_player_control_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/tv_spacing_lg"
    android:paddingTop="@dimen/tv_spacing_lg"
    android:paddingEnd="@dimen/tv_spacing_lg"
    android:paddingBottom="@dimen/tv_spacing_md">

    <!-- ════════════════════════════════════════════════════════════════════════════
         解析源选择器
         ════════════════════════════════════════════════════════════════════════════ -->
    <com.fongmi.android.tv.ui.custom.CustomHorizontalGridView
        android:id="@+id/parse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tv_spacing_lg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/tv_spacing_xxs"
        android:visibility="gone"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        tools:ignore="RtlSymmetry"
        tools:layout_height="40dp" />

    <!-- ════════════════════════════════════════════════════════════════════════════
         主要控制按钮区域
         ════════════════════════════════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/actionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="@dimen/tv_spacing_xs">

            <!-- ═══════════════════════════════════════════════════════════════════
                 播放控制组 - 上一集/下一集/选集
                 ═══════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                style="@style/VideoControlGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- 上一集按钮 -->
                <TextView
                    android:id="@+id/prev"
                    style="@style/VideoControlButton.IconOnly"
                    android:contentDescription="@string/play_prev"
                    android:drawableTop="@drawable/ic_skip_previous" />

                <!-- 下一集按钮 -->
                <TextView
                    android:id="@+id/next"
                    style="@style/VideoControlButton.IconOnly"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    android:contentDescription="@string/play_next"
                    android:drawableTop="@drawable/ic_skip_next" />

                <!-- 选集按钮 -->
                <TextView
                    android:id="@+id/episodes"
                    style="@style/VideoControlButton.IconOnly"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    android:contentDescription="@string/play_episodes"
                    android:drawableTop="@drawable/ic_playlist" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════════
                 播放器设置组 - 播放器/解码/刷新
                 ═══════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                style="@style/VideoControlGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/player"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="EXO" />

                <TextView
                    android:id="@+id/decode"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    tools:text="硬解" />

                <TextView
                    android:id="@+id/reset"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    tools:text="刷新" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════════
                 播放设置组 - 速度/比例/循环
                 ═══════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                style="@style/VideoControlGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/speed"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="1.00" />

                <TextView
                    android:id="@+id/scale"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    tools:text="預設" />

                <TextView
                    android:id="@+id/loop"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    android:text="@string/play_loop" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════════
                 轨道设置组 - 字幕/音轨/视频轨
                 ═══════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                style="@style/VideoControlGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/text"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="3"
                    android:text="@string/play_track_text"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/audio"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    android:tag="1"
                    android:text="@string/play_track_audio"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/video"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    android:tag="2"
                    android:text="@string/play_track_video"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════════
                 时间设置组 - 片头/片尾跳过
                 ═══════════════════════════════════════════════════════════════════ -->
            <LinearLayout
                style="@style/VideoControlGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/opening"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="片头" />

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/ending"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="@dimen/tv_spacing_xxs"
                    tools:text="片尾" />
            </LinearLayout>

            <!-- ═══════════════════════════════════════════════════════════════════
                 弹幕设置按钮
                 ═══════════════════════════════════════════════════════════════════ -->
            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/danmu"
                style="@style/VideoControlButton.Accent"
                android:text="@string/play_danmu" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ════════════════════════════════════════════════════════════════════════════
         进度条区域
         ════════════════════════════════════════════════════════════════════════════ -->
    <com.fongmi.android.tv.ui.custom.CustomSeekView
        android:id="@+id/seek"
        style="@style/VideoSeekBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>