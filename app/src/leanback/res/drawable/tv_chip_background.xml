<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 芯片/标签背景
    用于筛选器、标签等
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_chip_selected"/>
            <corners android:radius="@dimen/tv_chip_corner_radius"/>
        </shape>
    </item>
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_chip_focused"/>
            <corners android:radius="@dimen/tv_chip_corner_radius"/>
        </shape>
    </item>
    
    <!-- 选中/激活状态 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_chip_selected"/>
            <corners android:radius="@dimen/tv_chip_corner_radius"/>
        </shape>
    </item>
    
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_chip_selected"/>
            <corners android:radius="@dimen/tv_chip_corner_radius"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_chip_bg"/>
            <corners android:radius="@dimen/tv_chip_corner_radius"/>
        </shape>
    </item>
    
</selector>