    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="160"
    android:viewportHeight="160">
    <!-- 0.72 → ~28% margin to rim (was 0.88, still tight against outer disc). -->
    <group
        android:translateX="22.4"
        android:translateY="22.4"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <path
            android:fillColor="#24221F"
            android:pathData="M31,27h68l30,30v76H61l-30,-30V27Z" />
        <path
            android:fillColor="#F3EFE7"
            android:pathData="M54,51h34l18,18v40H72L54,91V51Z" />
        <path
            android:fillColor="#C75B3F"
            android:pathData="M99,27h30v30L99,27Z" />
        <path
            android:fillColor="#C75B3F"
            android:pathData="M31,103h30v30l-30,-30Z" />
    </group>
</vector>
