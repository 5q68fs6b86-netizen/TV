<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamVodOvalRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.fongmi.android.tv.ui.custom.JetStreamAvatarImageView
        android:id="@+id/image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp" />

    <com.fongmi.android.tv.ui.custom.JetStreamLargeSupportingLabelTextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/image"
        android:layout_alignStart="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_marginTop="4dp"
        android:ellipsize="marquee"
        android:duplicateParentState="true"
        android:gravity="center"
        android:singleLine="true"
        tools:text="蜘蛛人" />

    <com.fongmi.android.tv.ui.custom.JetStreamVodOvalFocusLayout
        android:id="@+id/frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@+id/image"
        android:layout_alignTop="@+id/image"
        android:layout_alignEnd="@+id/image"
        android:layout_alignBottom="@+id/image"
        android:duplicateParentState="true" />

</com.fongmi.android.tv.ui.custom.JetStreamVodOvalRootLayout>
