<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 轮廓按钮背景
    透明背景+边框，支持焦点和按下状态
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 禁用状态 -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/tv_button_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_thin"
                android:color="@color/tv_text_disabled"/>
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_outline_bg_focused"/>
            <corners android:radius="@dimen/tv_button_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_primary"/>
        </shape>
    </item>
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_outline_bg_focused"/>
            <corners android:radius="@dimen/tv_button_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_button_outline_stroke_focused"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/tv_button_corner_radius"/>
            <stroke
                android:width="@dimen/tv_stroke_default"
                android:color="@color/tv_button_outline_stroke"/>
        </shape>
    </item>
    
</selector>