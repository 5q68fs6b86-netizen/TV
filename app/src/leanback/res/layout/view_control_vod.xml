<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/video_control_modern_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_xlarge"
    android:paddingEnd="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_normal">

    <!-- 解析源选择器 (已修改) -->
    <com.fongmi.android.tv.ui.custom.CustomHorizontalGridView
        android:id="@+id/parse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="@dimen/spacing_tiny"
        android:visibility="gone"
        app:focusOutEnd="true"
        app:focusOutFront="true"
        tools:ignore="RtlSymmetry"
        tools:layout_height="40dp" />

    <!-- 主要控制按钮区域 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/actionLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <!-- ======================================================= -->
            <!-- 播放控制组 (已修改为只显示图标) -->
            <!-- ======================================================= -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- 上一集按钮 -->
                <TextView
                    android:id="@+id/prev"
                    style="@style/VideoControlButton.IconOnly"
                    android:contentDescription="@string/play_prev"
                    android:drawableTop="@drawable/ic_skip_previous" />

                <!-- 下一集按钮 -->
                <TextView
                    android:id="@+id/next"
                    style="@style/VideoControlButton.IconOnly"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/play_next"
                    android:drawableTop="@drawable/ic_skip_next" />

                <!-- 选集按钮 -->
                <TextView
                    android:id="@+id/episodes"
                    style="@style/VideoControlButton.IconOnly"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/play_episodes"
                    android:drawableTop="@drawable/ic_playlist" />
            </LinearLayout>

            <!-- ======================================================= -->
            <!-- 播放器设置组 (保持原样：图标+文字) -->
            <!-- ======================================================= -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/player"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="EXO" />

                <TextView
                    android:id="@+id/decode"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="硬解" />

                <TextView
                    android:id="@+id/reset"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="刷新" />
            </LinearLayout>

            <!-- ======================================================= -->
            <!-- 播放设置组 (保持原样) -->
            <!-- ======================================================= -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/speed"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="1.00" />

                <TextView
                    android:id="@+id/scale"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="預設" />

                <TextView
                    android:id="@+id/loop"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:text="@string/play_loop" />
            </LinearLayout>

            <!-- ======================================================= -->
            <!-- 轨道设置组 (保持原样) -->
            <!-- ======================================================= -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/text"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="3"
                    android:text="@string/play_track_text"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/audio"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:tag="1"
                    android:text="@string/play_track_audio"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/video"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:tag="2"
                    android:text="@string/play_track_video"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ======================================================= -->
            <!-- 时间设置组 (保持原样) -->
            <!-- ======================================================= -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/opening"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="片头" />

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/ending"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="片尾" />
            </LinearLayout>

            <!-- ======================================================= -->
            <!-- 弹幕设置 (保持原样) -->
            <!-- ======================================================= -->
            <com.fongmi.android.tv.ui.custom.CustomUpDownView
                android:id="@+id/danmu"
                style="@style/VideoControlButton.Accent"
                android:text="@string/play_danmu" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 进度条区域 (保持不变) -->
    <com.fongmi.android.tv.ui.custom.CustomSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp" />

</LinearLayout>