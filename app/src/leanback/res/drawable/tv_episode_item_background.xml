<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 剧集项背景
    用于视频详情页的剧集列表
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_episode_pressed"/>
            <corners android:radius="@dimen/tv_radius_sm"/>
        </shape>
    </item>
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_episode_focused"/>
            <corners android:radius="@dimen/tv_radius_sm"/>
        </shape>
    </item>
    
    <!-- 选中/激活状态（当前播放的剧集） -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_episode_active"/>
            <corners android:radius="@dimen/tv_radius_sm"/>
        </shape>
    </item>
    
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_episode_active"/>
            <corners android:radius="@dimen/tv_radius_sm"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_episode_bg"/>
            <corners android:radius="@dimen/tv_radius_sm"/>
        </shape>
    </item>
    
</selector>