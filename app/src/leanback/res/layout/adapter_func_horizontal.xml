<?xml version="1.0" encoding="utf-8"?>
<!--
    功能按钮适配器布局 (水平样式)
    使用 TV 设计系统
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/tv_button_height_lg"
    android:layout_margin="@dimen/tv_spacing_xs"
    android:background="@drawable/tv_button_secondary_background"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center"
    android:paddingHorizontal="@dimen/tv_button_padding_horizontal"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/tv_icon_md"
        android:layout_height="@dimen/tv_icon_md"
        android:layout_gravity="center_vertical"
        app:tint="@color/tv_icon_primary"
        tools:src="@drawable/ic_home_vod" />

    <TextView
        android:id="@+id/text"
        style="@style/TV.Text.Body.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/tv_spacing_xs"
        android:textColor="@color/tv_text_primary"
        tools:text="点播" />

</LinearLayout>