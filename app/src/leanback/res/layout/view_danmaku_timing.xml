<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamDanmakuSectionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true">

            <com.fongmi.android.tv.ui.custom.JetStreamSliderTitleTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:text="@string/danmaku_time_offset" />

            <com.fongmi.android.tv.ui.custom.JetStreamSliderValueTextView
                android:id="@+id/timeOffsetValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true" />

        </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamSlider
            android:id="@+id/timeOffsetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusUp="@id/tabTiming"
            android:stepSize="1000"
            android:valueFrom="-300000"
            android:valueTo="300000"
            app:tickVisible="false" />

    </com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true">

            <com.fongmi.android.tv.ui.custom.JetStreamSliderTitleTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:text="@string/danmaku_duration" />

            <com.fongmi.android.tv.ui.custom.JetStreamSliderValueTextView
                android:id="@+id/durationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true" />

        </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamSlider
            android:id="@+id/durationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:stepSize="500"
            android:valueFrom="3000"
            android:valueTo="15000"
            app:tickVisible="false" />

    </com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true">

            <com.fongmi.android.tv.ui.custom.JetStreamSliderTitleTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:text="@string/danmaku_fixed_duration" />

            <com.fongmi.android.tv.ui.custom.JetStreamSliderValueTextView
                android:id="@+id/fixedDurationValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true" />

        </com.fongmi.android.tv.ui.custom.JetStreamDanmakuControlRowLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamSlider
            android:id="@+id/fixedDurationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:stepSize="500"
            android:valueFrom="2000"
            android:valueTo="10000"
            app:tickVisible="false" />

    </com.fongmi.android.tv.ui.custom.JetStreamDialogContentLayout>

</com.fongmi.android.tv.ui.custom.JetStreamDanmakuSectionLayout>
