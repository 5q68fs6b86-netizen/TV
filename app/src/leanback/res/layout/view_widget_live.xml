<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPlaybackOverlayRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTopBarLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="48dp"
        android:paddingTop="20dp"
        android:paddingEnd="48dp"
        android:paddingBottom="18dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/title"
            style="@style/Shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/clock"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="20sp"
            tools:text="民視" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/size"
            style="@style/Shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/title"
            android:layout_alignStart="@+id/title"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="16sp"
            tools:text="1920 x 1080" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/clock"
            style="@style/Shadow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="20sp"
            tools:text="09:20:00" />

    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackTopBarLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout
        android:id="@+id/error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelIconView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_error" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="16sp"
            tools:text="@string/error_play_url" />

    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackWidgetTextView
        android:id="@+id/digital"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.05"
        android:textColor="@color/jetstream_on_surface"
        android:textSize="64sp"
        android:visibility="gone"
        tools:text="05"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelIconView
            android:id="@+id/action"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_widget_play" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeRowLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
                android:id="@+id/position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/jetstream_on_surface"
                android:textSize="16sp"
                tools:text="00:00:00" />

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="/"
                android:textColor="@color/jetstream_on_surface_variant"
                android:textSize="16sp" />

            <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="@color/jetstream_on_surface"
                android:textSize="16sp"
                tools:text="00:00:00" />

        </com.fongmi.android.tv.ui.custom.JetStreamPlaybackTimeRowLayout>
    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackPanelLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamLiveBottomBarLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="14dp"
        android:paddingEnd="48dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="18sp"
            tools:text="005" />

        <com.fongmi.android.tv.ui.custom.JetStreamLogoImageView
            android:id="@+id/logo"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:visibility="gone" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:maxEms="48"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="17sp"
            tools:text="民視" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/play"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="16sp"
            tools:text="正在播放：食神" />

        <com.fongmi.android.tv.ui.custom.JetStreamPlaybackLabelTextView
            android:id="@+id/line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="16sp"
            tools:text="來源 1" />

    </com.fongmi.android.tv.ui.custom.JetStreamLiveBottomBarLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPlaybackOverlayRootLayout>
