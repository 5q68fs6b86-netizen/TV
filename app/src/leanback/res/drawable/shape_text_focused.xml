<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景填充色 -->
    <solid android:color="@color/grey_500" />

    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#ffafc9" />

    <!-- 圆角 -->
    <corners android:radius="8dp" />

    <!-- 内边距 -->
    <padding
        android:bottom="8dp"
        android:left="12dp"
        android:right="12dp"
        android:top="8dp" />

</shape>