<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_state_surface"
        android:gravity="center"
        android:minWidth="168dp"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="28dp"
        android:paddingEnd="30dp"
        android:paddingBottom="26dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/jetstream_primary"
            app:indicatorSize="@dimen/progress_indicator_size"
            app:trackColor="@color/jetstream_outline_variant"
            app:trackCornerRadius="@dimen/progress_indicator_corner_radius"
            app:trackThickness="@dimen/progress_indicator_track_thickness" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/traffic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/jetstream_on_surface_variant"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="120 KB/s"
            tools:visibility="visible" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
