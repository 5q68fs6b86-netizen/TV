<resources>

    <style name="Vod">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="Vod.Grid">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
    </style>

    <style name="Vod.Grid.Large">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Vod.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Vod.List">
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeBottomLeft">8dp</item>
    </style>

    <style name="Player">
        <item name="resize_mode">fit</item>
        <item name="use_artwork">true</item>
        <item name="use_controller">false</item>
    </style>

    <style name="Player.Vod">
        <item name="keep_content_on_player_reset">false</item>
    </style>

    <style name="Player.Live">
        <item name="keep_content_on_player_reset">true</item>
    </style>

    <style name="JetStreamActivityAnim">
        <item name="android:activityOpenEnterAnimation">@anim/jetstream_activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/jetstream_activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/jetstream_activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/jetstream_activity_close_exit</item>
    </style>

    <style name="JetStreamDialogAnim">
        <item name="android:windowEnterAnimation">@anim/jetstream_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/jetstream_dialog_exit</item>
    </style>

    <style name="JetStreamBottomSheetAnim">
        <item name="android:windowEnterAnimation">@anim/jetstream_bottom_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/jetstream_bottom_sheet_exit</item>
    </style>

    <style name="JetStreamSideSheetAnim">
        <item name="android:windowEnterAnimation">@anim/jetstream_side_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/jetstream_side_sheet_exit</item>
    </style>

</resources>
