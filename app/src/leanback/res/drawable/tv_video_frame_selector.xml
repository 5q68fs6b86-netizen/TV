<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器框架选择器
    用于焦点状态的视觉反馈
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 - 显示焦点边框 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_primary" />
            <corners android:radius="@dimen/tv_radius_md" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_primary_variant" />
            <corners android:radius="@dimen/tv_radius_md" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- 默认状态 - 透明 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/tv_radius_md" />
        </shape>
    </item>
</selector>