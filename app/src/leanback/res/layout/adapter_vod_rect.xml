<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/vod_card_width"
    android:layout_height="@dimen/vod_card_height"
    android:layout_margin="@dimen/card_margin_medium"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 主要卡片容器 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        app:cardCornerRadius="@dimen/radius_xlarge"
        app:cardElevation="@dimen/elevation_large"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/card_background_light">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/media_thumbnail_placeholder"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/Vod.Grid"
                tools:src="@drawable/ic_img_loading" />

            <!-- 年份標籤 -->
            <TextView
                android:id="@+id/year"
                style="@style/TVTag.Info"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="@dimen/spacing_small"
                android:visibility="gone"
                tools:text="2022"
                tools:visibility="visible" />

            <!-- 站點標籤 -->
            <TextView
                android:id="@+id/site"
                style="@style/TVTag.Secondary"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/spacing_small"
                android:visibility="gone"
                tools:text="泥巴"
                tools:visibility="visible" />

            <!-- 質量標籤 -->
            <TextView
                android:id="@+id/remark"
                style="@style/TVTag.Primary"
                android:layout_above="@+id/name"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/spacing_small"
                tools:text="1080P" />

            <!-- 漸變遮罩 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/video_control_gradient_bg" />

            <!-- 標題文本 -->
            <TextView
                android:id="@+id/name"
                style="@style/TVVodTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_margin="@dimen/spacing_medium"
                android:gravity="start|center_vertical"
                tools:text="蜘蛛俠：英雄無歸" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <!-- 焦點選擇器 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_vod"
        android:duplicateParentState="true" />

</RelativeLayout>
