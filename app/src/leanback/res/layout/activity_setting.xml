<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_gradient"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:keepScreenOn="true"
    android:padding="48dp">

    <!-- Header -->
    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_setting"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settingsTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: Content -->
            <TextView
                style="@style/TextAppearance.Leanback.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Content Source"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:orientation="vertical">

                <!-- VOD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/vod"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/video_button_secondary_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.3"
                            android:text="@string/setting_vod"
                            android:textColor="@color/video_button_secondary_text"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/vodUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textColor="@color/video_button_secondary_text"
                            android:alpha="0.7"
                            android:textSize="16sp"
                            tools:text="https://..." />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/vodHome"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_home"
                        app:tint="@color/icon_tint_selector" />

                    <ImageView
                        android:id="@+id/vodHistory"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_history"
                        app:tint="@color/icon_tint_selector" />

                </LinearLayout>

                <!-- LIVE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/live"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/video_button_secondary_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.3"
                            android:text="@string/setting_live"
                            android:textColor="@color/video_button_secondary_text"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/liveUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textColor="@color/video_button_secondary_text"
                            android:alpha="0.7"
                            android:textSize="16sp"
                            tools:text="https://..." />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/liveHome"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_home"
                        app:tint="@color/icon_tint_selector" />

                    <ImageView
                        android:id="@+id/liveHistory"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_history"
                        app:tint="@color/icon_tint_selector" />

                </LinearLayout>

                <!-- WALL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/wall"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/video_button_secondary_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center_vertical"
                        android:nextFocusDown="@id/player"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.3"
                            android:text="@string/setting_wall"
                            android:textColor="@color/video_button_secondary_text"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/wallUrl"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.7"
                            android:ellipsize="middle"
                            android:gravity="end"
                            android:singleLine="true"
                            android:textColor="@color/video_button_secondary_text"
                            android:alpha="0.7"
                            android:textSize="16sp"
                            tools:text="https://..." />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/wallDefault"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/player"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_home"
                        app:tint="@color/icon_tint_selector" />

                    <ImageView
                        android:id="@+id/wallRefresh"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/video_control_button_selector"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusDown="@id/player"
                        android:padding="16dp"
                        android:src="@drawable/ic_setting_refresh"
                        app:tint="@color/icon_tint_selector" />

                </LinearLayout>

            </LinearLayout>

            <!-- Section: Player &amp; System -->
            <TextView
                style="@style/TextAppearance.Leanback.Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="System &amp; Playback"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- Player -->
                <LinearLayout
                    android:id="@+id/player"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_player"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Danmu -->
                <LinearLayout
                    android:id="@+id/danmu"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_danmu"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Custom -->
                <LinearLayout
                    android:id="@+id/custom"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_custom"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Proxy -->
                <LinearLayout
                    android:id="@+id/proxy"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_proxy"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/proxyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="None" />
                </LinearLayout>

                <!-- Backup -->
                <LinearLayout
                    android:id="@+id/backup"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_backup"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/backupText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="Auto" />
                </LinearLayout>

                <!-- Restore -->
                <LinearLayout
                    android:id="@+id/restore"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_restore"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Cache -->
                <LinearLayout
                    android:id="@+id/cache"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_cache"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/cacheText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="0MB" />
                </LinearLayout>

                <!-- DOH -->
                <LinearLayout
                    android:id="@+id/doh"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_doh"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/dohText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="Google" />
                </LinearLayout>

                <!-- Version -->
                <LinearLayout
                    android:id="@+id/version"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/setting_version"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/versionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="1.0.0" />
                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:id="@+id/about"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/video_button_secondary_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_about"
                        android:textColor="@color/video_button_secondary_text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/aboutText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="@color/video_button_secondary_text"
                        android:alpha="0.7"
                        android:textSize="16sp"
                        tools:text="" />
                </LinearLayout>

            </GridLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>