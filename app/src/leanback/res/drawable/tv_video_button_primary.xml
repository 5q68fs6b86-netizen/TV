<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器主要按钮背景
    焦点时使用 Google TV 焦点蓝色
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 聚焦状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_primary" />
            <corners android:radius="@dimen/tv_radius_full" />
        </shape>
    </item>
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_primary_bg_pressed" />
            <corners android:radius="@dimen/tv_radius_full" />
        </shape>
    </item>
    
    <!-- 激活/选中状态 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_primary_variant" />
            <corners android:radius="@dimen/tv_radius_full" />
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_button_primary_bg" />
            <corners android:radius="@dimen/tv_radius_full" />
        </shape>
    </item>
</selector>