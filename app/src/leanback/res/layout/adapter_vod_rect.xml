<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/poster"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/selector_vod">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/jetstream_surface_container_high"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/JetStream.Card" />

        <View
            android:id="@+id/scrim"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_vod_scrim" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_vod_year"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="2022"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/shape_vod_site"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="泥巴"
            tools:visibility="visible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/remark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/shape_vod_remark"
            android:ellipsize="end"
            android:maxWidth="120dp"
            android:singleLine="true"
            android:textColor="@color/jetstream_on_surface"
            android:textSize="12sp"
            tools:text="1080p" />

    </FrameLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_marginTop="4dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/selector_vod_title"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="蜘蛛人" />

</androidx.appcompat.widget.LinearLayoutCompat>
