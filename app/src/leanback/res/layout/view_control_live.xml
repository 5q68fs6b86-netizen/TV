<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/video_control_modern_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_xlarge"
    android:paddingEnd="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_normal">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp"
            tools:ignore="RtlHardcoded,UnusedAttribute">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/player"
                    style="@style/VideoControlButton.Secondary"
                    android:nextFocusLeft="@id/change"
                    tools:text="EXO" />

                <TextView
                    android:id="@+id/decode"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="硬解" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/speed"
                    style="@style/VideoControlButton.Secondary"
                    android:visibility="gone"
                    tools:text="1.00"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/scale"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    tools:text="預設" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/home"
                    style="@style/VideoControlButton.Secondary"
                    tools:text="首頁" />

                <TextView
                    android:id="@+id/line"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"
                    tools:text="來源 1"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.fongmi.android.tv.ui.custom.CustomUpDownView
                    android:id="@+id/text"
                    style="@style/VideoControlButton.Secondary"
                    android:tag="3"
                    android:text="@string/play_track_text"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/audio"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:tag="1"
                    android:text="@string/play_track_audio"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/video"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:tag="2"
                    android:text="@string/play_track_video"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/control_group_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/invert"
                    style="@style/VideoControlButton.Secondary"
                    android:text="@string/play_invert" />

                <TextView
                    android:id="@+id/across"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:text="@string/play_across" />

                <TextView
                    android:id="@+id/change"
                    style="@style/VideoControlButton.Secondary"
                    android:layout_marginStart="4dp"
                    android:nextFocusRight="@id/player"
                    android:text="@string/play_change" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <com.fongmi.android.tv.ui.custom.CustomSeekView
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal" />

</LinearLayout>