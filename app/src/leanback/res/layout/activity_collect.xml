<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fongmi.android.tv.ui.custom.JetStreamPageBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="36dp"
        android:paddingEnd="48dp">

        <com.fongmi.android.tv.ui.custom.JetStreamPageHeaderView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            app:jetStreamSubtitle="@string/setting_page_collect_desc"
            app:jetStreamTitle="@string/home_search" />

        <com.fongmi.android.tv.ui.custom.JetStreamPagePanelLayout
            android:id="@+id/recyclerPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <com.fongmi.android.tv.ui.custom.JetStreamHorizontalGridView
                android:id="@+id/recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:focusOutEnd="false"
                app:focusOutFront="false" />

        </com.fongmi.android.tv.ui.custom.JetStreamPagePanelLayout>

        <com.fongmi.android.tv.ui.custom.JetStreamPagePanelLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="36dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.fongmi.android.tv.ui.custom.JetStreamPageViewPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.fongmi.android.tv.ui.custom.JetStreamPagePanelLayout>

    </com.fongmi.android.tv.ui.custom.JetStreamPageContentLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPageRootLayout>
