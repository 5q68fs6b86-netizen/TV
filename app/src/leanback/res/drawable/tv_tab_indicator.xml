<?xml version="1.0" encoding="utf-8"?>
<!--
    TV Tab指示器
    用于显示当前选中的Tab
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 底部指示条 -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="@dimen/tv_tab_indicator_height"/>
            <solid android:color="@color/tv_tab_indicator"/>
            <corners android:radius="@dimen/tv_radius_xs"/>
        </shape>
    </item>
    
</layer-list>