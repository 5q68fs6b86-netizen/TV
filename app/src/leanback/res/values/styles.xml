<resources>

    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowAnimationStyle">@style/NoAnim</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">#141218</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowBackground">@color/grey_800</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="NoAnim">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_chip_round</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:nextFocusUp">@id/exo_progress</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/jetstream_control_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="JetStream.Shape">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="JetStream.Shape.Control">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="JetStream.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/jetstream_control_text</item>
        <item name="backgroundTint">@color/jetstream_control_container</item>
        <item name="iconTint">@color/jetstream_control_text</item>
        <item name="rippleColor">@color/white_20</item>
        <item name="shapeAppearance">@style/JetStream.Shape.Control</item>
        <item name="strokeColor">@color/jetstream_control_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="JetStream.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">40dp</item>
        <item name="android:textColor">@color/jetstream_control_text</item>
        <item name="backgroundTint">@color/jetstream_control_container</item>
        <item name="rippleColor">@color/white_20</item>
        <item name="shapeAppearance">@style/JetStream.Shape.Control</item>
        <item name="strokeColor">@color/jetstream_control_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="JetStream.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:textColor">@color/jetstream_control_text</item>
        <item name="checkedIconTint">@color/jetstream_control_text</item>
        <item name="chipBackgroundColor">@color/jetstream_control_container</item>
        <item name="chipStrokeColor">@color/jetstream_control_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="rippleColor">@color/white_20</item>
        <item name="shapeAppearance">@style/JetStream.Shape.Control</item>
    </style>

    <style name="JetStream.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/jetstream_switch_thumb</item>
        <item name="trackTint">@color/jetstream_switch_track</item>
        <item name="trackTintMode">src_in</item>
    </style>

    <style name="JetStream.Slider" parent="Widget.Material3.Slider">
        <item name="haloColor">@color/jetstream_scrim_medium</item>
        <item name="thumbColor">@color/jetstream_primary</item>
        <item name="trackColorActive">@color/jetstream_primary</item>
        <item name="trackColorInactive">@color/white_10</item>
        <item name="trackHeight">6dp</item>
    </style>

    <style name="JetStream">
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="JetStream.Card">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="JetStream.Hero">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
