<?xml version="1.0" encoding="utf-8"?>
<!--
    视频播放器显示信息布局
    全屏播放时的信息覆盖层
    遵循 Google TV 设计规范
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ════════════════════════════════════════════════════════════════════════════
         标题区域 (左上角)
         ════════════════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_marginTop="@dimen/tv_spacing_md"
        android:layout_marginStart="@dimen/tv_spacing_md"
        android:orientation="vertical"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/title"
            style="@style/VideoTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="100dp"
            android:letterSpacing="0.02"
            android:singleLine="true"
            tools:text="慶餘年第一季：第一集" />

        <TextView
            android:id="@+id/size"
            style="@style/VideoInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="1920 x 1080" />
    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════════════════
         时钟 (右上角)
         ════════════════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/clock"
        style="@style/VideoTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/tv_spacing_md"
        android:layout_marginEnd="@dimen/tv_spacing_md"
        tools:text="10:20:00" />

    <!-- ════════════════════════════════════════════════════════════════════════════
         播放时长 (左下角)
         ════════════════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/duration"
        style="@style/VideoInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="@dimen/tv_spacing_md"
        android:layout_marginStart="@dimen/tv_spacing_md"
        tools:text="00:00-10:20" />

    <!-- ════════════════════════════════════════════════════════════════════════════
         网速 (右下角)
         ════════════════════════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/netspeed"
        style="@style/VideoInfoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="@dimen/tv_spacing_md"
        android:layout_marginEnd="@dimen/tv_spacing_md"
        tools:text="10MB/S"/>

    <!-- ════════════════════════════════════════════════════════════════════════════
         底部进度条
         ════════════════════════════════════════════════════════════════════════════ -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_progress_height_sm"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/tv_display_progress"
        tools:progress="50" />

</RelativeLayout>