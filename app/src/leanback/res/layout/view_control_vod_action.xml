<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamPlaybackActionScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.fongmi.android.tv.ui.custom.JetStreamPlaybackActionRowLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:nextFocusLeft="@id/repeat"
            android:text="@string/play_next" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_prev" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_reset" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/replay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_replay" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/change2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_change" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/player_engine" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/decode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_decode" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/parse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/parse"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.JetStreamNumericControlUpDownView
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_speed" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_scale" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlUpDownView
            android:id="@+id/text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:tag="3"
            android:text="@string/play_track_text" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:tag="1"
            android:text="@string/play_track_audio" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:tag="2"
            android:text="@string/play_track_video" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/aiSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/ai_subtitle_off" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/aiLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/ai_subtitle_language" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlUpDownView
            android:id="@+id/opening"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_op" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlUpDownView
            android:id="@+id/ending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_ed" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/danmaku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/danmaku"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/edition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_edition"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/chapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/play_chapter"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.fongmi.android.tv.ui.custom.JetStreamControlTextView
            android:id="@+id/repeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:nextFocusRight="@id/next"
            android:text="@string/play_repeat" />

    </com.fongmi.android.tv.ui.custom.JetStreamPlaybackActionRowLayout>
</com.fongmi.android.tv.ui.custom.JetStreamPlaybackActionScrollView>
