<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 列表项背景
    支持焦点、选中和按下状态
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 按下状态 -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_overlay"/>
            <corners android:radius="@dimen/tv_radius_md"/>
        </shape>
    </item>
    
    <!-- 焦点状态 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_elevated"/>
            <corners android:radius="@dimen/tv_radius_md"/>
            <stroke
                android:width="@dimen/tv_stroke_focus"
                android:color="@color/tv_focus_ring"/>
        </shape>
    </item>
    
    <!-- 选中状态 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_surface_variant"/>
            <corners android:radius="@dimen/tv_radius_md"/>
        </shape>
    </item>
    
    <!-- 激活状态 -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_focus_glow_subtle"/>
            <corners android:radius="@dimen/tv_radius_md"/>
            <stroke
                android:width="@dimen/tv_stroke_thin"
                android:color="@color/tv_focus_primary"/>
        </shape>
    </item>
    
    <!-- 默认状态 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/tv_radius_md"/>
        </shape>
    </item>
    
</selector>