<?xml version="1.0" encoding="utf-8"?>
<com.fongmi.android.tv.ui.custom.JetStreamFeaturedVodLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="324dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.fongmi.android.tv.ui.custom.JetStreamHeroImageView
        android:id="@+id/imageA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:src="@drawable/wallpaper_1" />

    <com.fongmi.android.tv.ui.custom.JetStreamHeroImageView
        android:id="@+id/imageB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.JetStreamFeaturedLeftScrimView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamFeaturedBottomScrimView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">

        <com.fongmi.android.tv.ui.custom.JetStreamHeroTitleTextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="44sp"
            android:textStyle="bold"
            tools:text="蜘蛛人" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroMetaTextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="2024  |  泥巴  |  1080p" />

        <com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout
            android:id="@+id/action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.fongmi.android.tv.ui.custom.JetStreamInlineIconView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_featured_play" />

            <com.fongmi.android.tv.ui.custom.JetStreamHeroActionTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/play" />

        </com.fongmi.android.tv.ui.custom.JetStreamHeroActionLayout>

    </com.fongmi.android.tv.ui.custom.JetStreamListItemContentLayout>

    <com.fongmi.android.tv.ui.custom.JetStreamHeroIndicatorLayout
        android:id="@+id/indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        tools:visibility="visible" />

</com.fongmi.android.tv.ui.custom.JetStreamFeaturedVodLayout>
